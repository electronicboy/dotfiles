# Read by every zsh (scripts too). Keep this tiny; PATH lives in .zprofile
# because macOS's /etc/zprofile (path_helper) reorders anything set here.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# SSH sessions often arrive without a locale, which breaks UTF-8 in prompts/git.
export LANG="${LANG:-en_GB.UTF-8}"
